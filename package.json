{
  "name": "portfolio-security-engineer",
  "version": "2.0.0",
  "description": "Security-focused portfolio for a software engineer",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && mkdir -p dist/public && cp -R public/. dist/public/",
    "start": "node dist/server.js",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:security": "node --test tests/security-load.mjs",
    "lint": "tsc --noEmit"
  },
  "author": "Starlyn Urena Ventura",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.2.4",
    "express": "^5.1.0",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "happy-dom": "^20.14.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
